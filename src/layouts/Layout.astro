---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  bodyClass?: string;
}

const {
  title,
  description = 'Sagar Ozpina — Vinaigre de cidre BIO du Pays Basque. Mono-verger, non filtré, non pasteurisé, avec la mère. Ferme Goyhenetxea, Soule.',
  ogImage = '/images/header.jpg',
  canonicalPath = '/',
  bodyClass = '',
} = Astro.props;

const siteUrl = 'https://ferme-broka.fr';
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="canonical" href={`${siteUrl}${canonicalPath}`}>

  <link rel="icon" href="/logo_seul.png" type="image/png">
  <link rel="apple-touch-icon" href="/logo_seul.png">

  <!-- Open Graph -->
  <meta property="og:type"        content="website">
  <meta property="og:url"         content={`${siteUrl}${canonicalPath}`}>
  <meta property="og:title"       content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image"       content={`${siteUrl}${ogImage}`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:locale"      content="fr_FR">
  <meta property="og:site_name"   content="BroKa — Ferme Goyhenetxea">

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image">
  <meta name="twitter:title"       content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image"       content={`${siteUrl}${ogImage}`}>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">

  <!-- Données structurées -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "BroKa — Ferme Goyhenetxea",
    "url": "https://ferme-broka.fr",
    "description": "Vinaigre de cidre BIO artisanal du Pays Basque. Mono-verger Soule.",
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "Soule — Xiberoa",
      "addressCountry": "FR"
    },
    "sameAs": [
      "https://www.facebook.com/search/top?q=broka%20maite%20et%20olivier%20gaec%20goyhenetxea",
      "https://www.instagram.com/broka_maite_olivier_latchere/"
    ]
  }
  </script>
</head>
<body class={bodyClass}>

  <!-- ══ NAVIGATION ══ -->
  <nav class="nav" role="navigation" aria-label="Navigation principale">
    <div class="nav-inner">
      <a href="/" class="nav-logo">BroK<span>a</span></a>

      <ul class="nav-links" id="nav-links" role="list">
        <li><a href="/sagar-ozpina" class={currentPath === '/sagar-ozpina' ? 'active' : ''}>Sagar Ozpina</a></li>
        <li><a href="/recettes"     class={currentPath.startsWith('/recettes') ? 'active' : ''}>Recettes</a></li>
        <li><a href="/histoire"     class={currentPath === '/histoire' ? 'active' : ''}>Notre histoire</a></li>
        <li><a href="/boutique"     class={currentPath === '/boutique' ? 'active' : ''}>Boutique</a></li>
      </ul>

      <div class="nav-right">
        <button class="nav-cart-btn" onclick="openCart()" aria-label="Ouvrir le panier">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/>
          </svg>
          <span class="cart-badge" id="cart-badge">0</span>
        </button>
        <button class="nav-hamburger" id="nav-hamburger" onclick="toggleNav()" aria-label="Menu" aria-expanded="false">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path id="hamburger-icon" d="M3 12h18M3 6h18M3 18h18"/>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- ══ CONTENU ══ -->
  <slot />

  <!-- ══ FOOTER ══ -->
  <footer>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <div class="footer-logo">BroKa</div>
          <p class="footer-motto">Vinaigre de cidre BIO Sagar Ozpina, Xipister et Poudre de Guindillas — fermentés lentement à la ferme Goyhenetxea, au cœur du Pays Basque français.</p>
          <div class="social-row">
            <a href="https://www.facebook.com/search/top?q=broka%20ma%C3%AFt%C3%A9%20et%20olivier%20gaec%20goyhenetxea" target="_blank" rel="noopener" class="social-ico" aria-label="Facebook">
              <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://www.instagram.com/broka_maite_olivier_latchere/" target="_blank" rel="noopener" class="social-ico" aria-label="Instagram">
              <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="https://wa.me/33770012652" target="_blank" rel="noopener" class="social-ico" aria-label="WhatsApp">
              <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </a>
          </div>
          <span class="footer-badge">🌿 Produit au Pays Basque, France</span>
        </div>

        <div>
          <p class="footer-heading">Nos produits</p>
          <ul class="footer-links">
            <li><a href="/boutique">Sagar Ozpina — 500 ml</a></li>
            <li><a href="/boutique">Recharge Vrac 1,5 L · 3 L</a></li>
            <li><a href="/boutique">Xipister — Sauce plancha</a></li>
            <li><a href="/boutique">Poudre de Guindillas</a></li>
            <li><a href="/boutique">Noisettes BIO coques</a></li>
            <li><a href="/boutique">Packs &amp; coffrets</a></li>
          </ul>
        </div>

        <div>
          <p class="footer-heading">Découvrir</p>
          <ul class="footer-links">
            <li><a href="/sagar-ozpina">Sagar Ozpina</a></li>
            <li><a href="/recettes">Recettes</a></li>
            <li><a href="/histoire">Notre histoire</a></li>
            <li><a href="/#marches">Marchés</a></li>
            <li><a href="/#guide">Guide gratuit</a></li>
          </ul>
        </div>

        <div>
          <p class="footer-heading">Informations</p>
          <ul class="footer-links">
            <li><a href="/mentions-legales">Mentions légales</a></li>
            <li><a href="/cgv">CGV</a></li>
            <li><a href="mailto:contact@ferme-broka.fr">Contact</a></li>
            <li><a href="https://wa.me/33770012652" target="_blank" rel="noopener">WhatsApp</a></li>
          </ul>
          <p class="footer-txt" style="margin-top:16px;font-size:.75rem;">
            Certifiés Agriculture Biologique FR-BIO-10
          </p>
        </div>
      </div>

      <div class="footer-bottom">
        <span class="footer-copy">© 2025 GAEC Goyhenetxea — BroKa. Tous droits réservés.</span>
        <div class="footer-legal-links">
          <a href="/mentions-legales">Mentions légales</a>
          <a href="/cgv">CGV</a>
          <a href="mailto:contact@ferme-broka.fr">Contact</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- ══ CART DRAWER ══ -->
  <div class="cart-overlay" id="cart-overlay" onclick="closeCart()"></div>
  <div class="cart-drawer" id="cart-drawer" role="dialog" aria-label="Panier">
    <div class="cart-head">
      <h3>🛒 Mon panier</h3>
      <button class="cart-close" onclick="closeCart()" aria-label="Fermer">✕</button>
    </div>
    <div class="cart-body">
      <div class="cart-empty" id="cart-empty">Votre panier est vide</div>
      <div id="cart-items"></div>
      <div class="cart-upsell" id="cart-upsell"></div>
    </div>
    <div class="cart-foot" id="cart-foot" style="display:none">
      <div class="cart-totals">
        <div class="cart-total-row"><span>Sous-total</span><span id="cart-subtotal">0 €</span></div>
        <div class="cart-total-row"><span>Point Relais</span><span id="cart-relay">—</span></div>
        <div class="cart-total-row main"><span>Total estimé</span><span id="cart-total">0 €</span></div>
      </div>
      <div class="cart-note" id="cart-home-note"></div>
      <div class="cart-note" id="cart-franco-note"></div>
      <div id="cart-launch-note" style="display:none"></div>
      <button class="btn btn-basque btn-full" onclick="checkoutCart()" style="margin-top:8px">
        Choisir la livraison →
      </button>
    </div>
  </div>

  <!-- ══ MODAL LIVRAISON ══ -->
  <div class="dlv-overlay" id="dlv-overlay">
    <div class="dlv-modal" id="dlv-modal">
      <div class="dlv-head">
        <h3>Mode de livraison</h3>
        <button class="dlv-close" onclick="closeDeliveryModal()" aria-label="Fermer">✕</button>
      </div>
      <div class="dlv-body">
        <div class="dlv-opts">
          <div class="dlv-opt" id="dlv-opt-relay" onclick="selectDeliveryOption('relay')">
            <div class="dlv-opt-title">📦 Point Relais® / Locker</div>
            <div class="dlv-opt-desc">Mondial Relay · 3–5 jours ouvrés</div>
            <div class="dlv-opt-price" id="dlv-relay-price">—</div>
          </div>
          <div class="dlv-opt" id="dlv-opt-home" onclick="selectDeliveryOption('home')">
            <div class="dlv-opt-title">🏠 À domicile</div>
            <div class="dlv-opt-desc">Colissimo · 3–5 jours ouvrés</div>
            <div class="dlv-opt-price" id="dlv-home-price">—</div>
          </div>
        </div>

        <!-- Point Relais -->
        <div class="dlv-section-body" id="dlv-relay-section">
          <div class="dlv-section-label">Votre point relais</div>
          <div class="dlv-field">
            <label>Code postal</label>
            <input type="text" id="dlv-cp-input" placeholder="Ex. 64000" maxlength="5" oninput="onRelayPostalInput(this.value)">
            <div id="mr-cp-hint" style="font-size:.75rem;color:var(--txt-lt);margin-top:4px;">Entrez votre code postal</div>
          </div>
          <div id="mr-steps" style="display:none">
            <div style="font-size:.78rem;color:var(--txt-lt);margin-bottom:12px;line-height:1.5;">
              Consultez la carte Mondial Relay, puis saisissez le nom du point relais choisi ci-dessous.
            </div>
            <a href="https://www.mondialrelay.fr/trouver-le-point-relais-le-plus-proche-de-chez-moi/" target="_blank" rel="noopener"
               style="display:inline-flex;align-items:center;gap:6px;font-size:.8rem;font-weight:700;color:var(--green-mid);margin-bottom:14px;">
              Voir la carte Mondial Relay →
            </a>
            <div class="dlv-field">
              <label>Nom du point relais choisi *</label>
              <input type="text" id="mr-manual-input" placeholder="Ex. Tabac Presse Martin — Pau" oninput="onManualRelayInput()">
            </div>
          </div>
        </div>

        <!-- Domicile -->
        <div class="dlv-section-body" id="dlv-home-section">
          <div class="dlv-section-label">Adresse de livraison</div>
          <div class="dlv-field">
            <label>Prénom Nom</label>
            <input type="text" id="home-name" placeholder="Marie Dupont">
          </div>
          <div class="dlv-field">
            <label>Adresse *</label>
            <input type="text" id="home-street" placeholder="12 rue des Pommiers" oninput="updateDeliveryConfirmBtn()">
          </div>
          <div style="display:grid;grid-template-columns:1fr 2fr;gap:12px">
            <div class="dlv-field">
              <label>Code postal *</label>
              <input type="text" id="home-postal" placeholder="64000" maxlength="5" oninput="updateDeliveryConfirmBtn()">
            </div>
            <div class="dlv-field">
              <label>Ville *</label>
              <input type="text" id="home-city" placeholder="Pau" oninput="updateDeliveryConfirmBtn()">
            </div>
          </div>
        </div>

        <!-- Contact -->
        <div class="dlv-contact">
          <div class="dlv-info-note">Votre email est requis pour recevoir la confirmation de commande et le suivi d'expédition.</div>
          <div class="dlv-field">
            <label>Email *</label>
            <input type="email" id="dlv-email" placeholder="vous@email.fr" oninput="updateDeliveryConfirmBtn()">
          </div>
          <div class="dlv-field">
            <label>Téléphone *</label>
            <input type="tel" id="dlv-phone" placeholder="06 12 34 56 78" oninput="formatTel(this);updateDeliveryConfirmBtn()">
          </div>
        </div>

        <button class="dlv-confirm-btn" id="dlv-confirm-btn" disabled onclick="confirmDelivery()">
          Payer →
        </button>
      </div>
    </div>
  </div>

  <!-- ══ CONFIRMATION PAIEMENT ══ -->
  <div id="confirm-overlay">
    <div class="confirm-card">
      <div class="confirm-icon">
        <svg width="32" height="32" fill="none" stroke="#16a34a" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
      </div>
      <h2>Commande confirmée !</h2>
      <p class="confirm-sub">Merci pour votre confiance.</p>
      <p class="confirm-note">Un email de confirmation vous a été envoyé. Votre commande sera expédiée sous 1 à 2 jours ouvrés.</p>
      <div class="confirm-actions">
        <a href="https://wa.me/33770012652" target="_blank" rel="noopener"
           style="display:flex;align-items:center;justify-content:center;gap:8px;background:#25D366;color:#fff;border-radius:8px;padding:12px 20px;font-size:.92rem;font-weight:700;text-decoration:none;">
          💬 Contacter via WhatsApp
        </a>
        <button onclick="document.getElementById('confirm-overlay').classList.remove('open')"
          style="background:none;border:1px solid #d1d5db;border-radius:8px;padding:10px;font-size:.88rem;cursor:pointer;">
          Fermer
        </button>
      </div>
    </div>
  </div>

  <!-- ══ MODAL AVIS ══ -->
  <div class="avis-modal-overlay" id="avis-modal-overlay" onclick="if(event.target===this)closeAvisModal()">
    <div class="avis-modal">
      <div id="avis-form-wrap">
        <h3 style="margin-bottom:20px">✍️ Laisser un avis</h3>
        <div style="margin-bottom:14px">
          <label style="display:block;font-size:.78rem;font-weight:700;color:var(--txt-md);margin-bottom:8px">Note *</label>
          <div id="stars-selector" style="display:flex;gap:8px;font-size:1.8rem;color:#d1d5db;cursor:pointer">
            <label onclick="selectStar(1)" onmouseover="updateStarDisplay(1)" onmouseout="updateStarDisplay(_avisRating)">★</label>
            <label onclick="selectStar(2)" onmouseover="updateStarDisplay(2)" onmouseout="updateStarDisplay(_avisRating)">★</label>
            <label onclick="selectStar(3)" onmouseover="updateStarDisplay(3)" onmouseout="updateStarDisplay(_avisRating)">★</label>
            <label onclick="selectStar(4)" onmouseover="updateStarDisplay(4)" onmouseout="updateStarDisplay(_avisRating)">★</label>
            <label onclick="selectStar(5)" onmouseover="updateStarDisplay(5)" onmouseout="updateStarDisplay(_avisRating)">★</label>
          </div>
          <span id="avis-err-rating" style="font-size:.75rem;color:#dc2626;display:none"></span>
        </div>
        <div style="margin-bottom:14px">
          <label style="display:block;font-size:.78rem;font-weight:700;color:var(--txt-md);margin-bottom:6px">Prénom *</label>
          <input id="avis-prenom" type="text" placeholder="Marie" style="width:100%;padding:10px 14px;border:1px solid var(--cream-bd);border-radius:var(--r-md);font-size:.9rem;font-family:var(--ff-body)">
          <span id="avis-err-prenom" style="font-size:.75rem;color:#dc2626;display:none"></span>
        </div>
        <div style="margin-bottom:14px">
          <label style="display:block;font-size:.78rem;font-weight:700;color:var(--txt-md);margin-bottom:6px">Votre avis *</label>
          <textarea id="avis-texte" rows="4" placeholder="Partagez votre expérience avec Sagar Ozpina…" maxlength="600"
            style="width:100%;padding:10px 14px;border:1px solid var(--cream-bd);border-radius:var(--r-md);font-size:.9rem;font-family:var(--ff-body);resize:vertical"></textarea>
          <span id="avis-err-texte" style="font-size:.75rem;color:#dc2626;display:none"></span>
        </div>
        <!-- Honeypot anti-spam (caché) -->
        <input type="text" id="avis-website" style="display:none" tabindex="-1" autocomplete="off">
        <button onclick="submitAvis()" style="width:100%;padding:12px;background:var(--green-deep);color:#fff;border:none;border-radius:var(--r-pill);font-size:.9rem;font-weight:700;cursor:pointer;margin-top:4px">
          Envoyer mon avis
        </button>
      </div>
      <div id="avis-success-wrap" style="display:none;text-align:center;padding:20px 0">
        <div style="font-size:3rem;margin-bottom:12px">✅</div>
        <h3 style="margin-bottom:8px">Merci pour votre avis !</h3>
        <p style="font-size:.88rem;color:var(--txt-lt)">Il sera publié après modération.</p>
        <button onclick="closeAvisModal()" style="margin-top:20px;background:none;border:1px solid var(--cream-bd);border-radius:var(--r-pill);padding:10px 24px;cursor:pointer;font-size:.88rem">
          Fermer
        </button>
      </div>
    </div>
  </div>

  <!-- ══ TOAST ══ -->
  <div class="toast" id="toast"></div>

  <!-- ══ SCRIPTS ══ -->
  <script src="/js/cart.js" defer></script>
  <script src="/js/market.js" defer></script>

  <script is:inline>
    // Navigation mobile
    function toggleNav() {
      const links = document.getElementById('nav-links');
      const btn   = document.getElementById('nav-hamburger');
      const open  = links.classList.toggle('open');
      btn.setAttribute('aria-expanded', open);
    }
    // Scroll animations
    document.addEventListener('DOMContentLoaded', () => {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.fi').forEach(el => obs.observe(el));

      // Confirmation paiement
      if (new URLSearchParams(location.search).get('paiement') === 'ok') {
        document.getElementById('confirm-overlay').classList.add('open');
        history.replaceState({}, '', location.pathname);
      }
    });
    // Avis modal
    let _avisRating = 0;
    function openAvisModal()  { document.getElementById('avis-modal-overlay').classList.add('open'); }
    function closeAvisModal() { document.getElementById('avis-modal-overlay').classList.remove('open'); }
    function selectStar(n) { _avisRating = n; updateStarDisplay(n); }
    function updateStarDisplay(n) {
      document.querySelectorAll('#stars-selector label').forEach((el, i) => {
        el.style.color = i < n ? '#F59E0B' : '#d1d5db';
      });
    }
    async function submitAvis() {
      const rating = _avisRating;
      const prenom = document.getElementById('avis-prenom').value.trim();
      const texte  = document.getElementById('avis-texte').value.trim();
      const honey  = document.getElementById('avis-website').value;
      if (honey) return;
      let ok = true;
      if (!rating) { document.getElementById('avis-err-rating').textContent = 'Choisissez une note'; document.getElementById('avis-err-rating').style.display = 'block'; ok = false; }
      if (!prenom) { document.getElementById('avis-err-prenom').textContent = 'Requis'; document.getElementById('avis-err-prenom').style.display = 'block'; ok = false; }
      if (texte.length < 10) { document.getElementById('avis-err-texte').textContent = 'Au moins 10 caractères'; document.getElementById('avis-err-texte').style.display = 'block'; ok = false; }
      if (!ok) return;
      try {
        const res = await fetch('/api/reviews', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rating, prenom, texte }) });
        if (res.ok) { document.getElementById('avis-form-wrap').style.display = 'none'; document.getElementById('avis-success-wrap').style.display = 'block'; }
        else showToast('❌ Erreur, réessayez.');
      } catch { showToast('❌ Erreur réseau.'); }
    }
    function showToast(msg, duration) {
      const t = document.getElementById('toast');
      t.textContent = msg; t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), duration || 3500);
    }
  </script>
</body>
</html>
