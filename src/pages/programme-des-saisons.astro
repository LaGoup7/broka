---
import Layout from '../layouts/Layout.astro';

const saisons = [
  {
    id:     'hiver',
    nom:    'Hiver',
    mois:   'Janvier · Février',
    icon:   '❄️',
    couleur: '#1e3a5f',
    bg:     '#eef2f8',
    bd:     '#c5d3e8',
    programme: 'Les 21 matins d\'attention',
    angle:   'Retour au simple',
    corps:  [
      'En janvier, Sagar Ozpina accompagne le retour aux gestes simples : un grand verre d\'eau, une cuillère de vinaigre, quelques minutes pour soi.',
      'Un programme de 21 matins, sans promesse, simplement pour renouer avec une habitude sobre, naturelle et attentive.',
      'En cuisine, c\'est aussi la saison des plats mijotés, des déglaçages et des sauces longues — là où une note acide apporte de la tension et de la profondeur.',
    ],
    usages: ['Rituel matinal dilué', 'Soupes et bouillons', 'Plats mijotés', 'Déglaçages'],
    astuce: 'Suggestion : diluer 1 c. à café à 1 c. à soupe dans un grand verre d\'eau. Ne jamais consommer pur.',
  },
  {
    id:     'printemps',
    nom:    'Printemps',
    mois:   'Mars · Avril · Mai',
    icon:   '🌿',
    couleur: '#166534',
    bg:     '#f0fdf4',
    bd:     '#bbf7d0',
    programme: 'Le rituel de printemps',
    angle:   'Fraîcheur & cuisine verte',
    corps: [
      'Au printemps, Sagar Ozpina retrouve naturellement sa place dans les salades, les herbes fraîches, les légumes nouveaux et les assiettes plus végétales.',
      'Sa vivacité et ses notes de pomme apportent une touche nette et lumineuse aux premières recettes de saison.',
      'C\'est le moment des vinaigrettes vives, des sauces froides aux herbes et des légumes croquants assaisonnés simplement.',
    ],
    usages: ['Vinaigrettes légères', 'Herbes fraîches', 'Légumes nouveaux', 'Sauces vertes'],
    astuce: null,
  },
  {
    id:     'ete',
    nom:    'Été',
    mois:   'Juin · Juillet · Août',
    icon:   '☀️',
    couleur: '#92400e',
    bg:     '#fffbeb',
    bd:     '#fde68a',
    programme: 'L\'été vif & basque',
    angle:   'Grillades, plancha & basque',
    corps: [
      'En été, Sagar Ozpina accompagne les grandes tablées, les grillades, les tomates anciennes, les marinades et les sauces froides.',
      'Avec le Xipister et la poudre de Guindillas, il devient un allié de cuisine pour les repas dehors, les planchas et les assiettes généreuses.',
      'C\'est la saison où la gamme BroKa s\'exprime pleinement : vinaigre, sauce basque, piment — trois ingrédients pour une cuisine vive et franche.',
    ],
    usages: ['Marinades plancha', 'Sauces froides', 'Tomates & poivrons', 'Xipister & Guindillas'],
    astuce: null,
  },
  {
    id:     'automne',
    nom:    'Automne',
    mois:   'Septembre · Octobre · Novembre',
    icon:   '🍎',
    couleur: '#7c2d12',
    bg:     '#fff7ed',
    bd:     '#fed7aa',
    programme: 'Le temps des pommes',
    angle:   'Récolte, verger & terroir',
    corps: [
      'À l\'automne, le vinaigre retrouve son origine : le verger, les pommes, la récolte, le pressage et le temps long de la fermentation.',
      'C\'est le moment idéal pour raconter les variétés anciennes — Moko, Urtebi handi, Patzolua, Gezamina — la Soule, l\'écopâturage et la transformation patiente du fruit en vinaigre.',
      'En cuisine, l\'automne est la saison des pommes rôties, des viandes confites, des champignons sautés et des plats qui demandent une note acide nette.',
    ],
    usages: ['Pommes & fruits rôtis', 'Champignons sautés', 'Viandes confites', 'Déglaçages profonds'],
    astuce: null,
  },
];
---

<Layout
  title="Programme des saisons — Sagar Ozpina toute l'année · BroKa"
  description="4 saisons, 4 façons d'intégrer Sagar Ozpina dans les gestes simples du quotidien. Rituels, recettes et usages au fil de l'année — vinaigre de cidre BIO basque."
  canonicalPath="/programme-des-saisons"
>

<div style="padding-top:68px">

  <!-- ════ HERO ════ -->
  <section style="background:var(--green-deep);padding:80px 0;color:#fff">
    <div class="container">
      <p class="sec-label fi" style="color:var(--brown-lt)">Rituels d'usage</p>
      <h1 class="fi" style="color:#fff">Le programme<br><em style="color:var(--brown-lt)">des saisons</em></h1>
      <div class="divider fi" style="background:var(--brown-lt)"></div>
      <p class="fi" style="color:rgba(255,255,255,.75);max-width:600px;font-size:1.05rem;line-height:1.8">
        4 saisons, 4 façons d'intégrer Sagar Ozpina dans les gestes simples du quotidien.
        En cuisine, à table, dans un verre d'eau, ou dans les recettes de saison.
      </p>

      <!-- Navigation saisons -->
      <div class="fi" style="display:flex;gap:12px;flex-wrap:wrap;margin-top:36px">
        {saisons.map(s => (
          <a href={`#${s.id}`} style={`background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:#fff;font-size:.82rem;font-weight:600;padding:8px 18px;border-radius:var(--r-pill);text-decoration:none;letter-spacing:.04em`}>
            {s.icon} {s.nom}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ INTRO ════ -->
  <section class="section-white" style="padding:72px 0 64px">
    <div class="container" style="max-width:800px">
      <p class="sec-label fi text-center">Le grand principe</p>
      <h2 class="fi text-center" style="margin-bottom:8px">Un rituel simple, toute l'année</h2>
      <div class="divider fi" style="margin:14px auto 28px"></div>
      <p class="fi text-center" style="font-size:1rem;color:var(--txt-md);line-height:1.8;margin-bottom:16px">
        Sagar Ozpina n'est pas un vinaigre ordinaire. Issu d'un seul verger basque, fermenté lentement,
        non filtré et conservé avec sa mère, il accompagne les gestes simples du quotidien :
        une vinaigrette, une marinade, un déglaçage, ou une cuillère diluée dans un grand verre d'eau.
      </p>
      <p class="fi text-center" style="font-size:1rem;color:var(--txt-md);line-height:1.8">
        Au fil des saisons, il trouve sa place dans les cuisines attentives, les tables familiales
        et les habitudes sobres.
      </p>
    </div>
  </section>

  <!-- ════ SAISONS ════ -->
  {saisons.map((s, i) => (
    <section id={s.id} style={`background:${i % 2 === 0 ? 'var(--cream)' : '#fff'};padding:80px 0`}>
      <div class="container">

        <!-- Saison header -->
        <div class="fi" style="display:flex;align-items:center;gap:20px;margin-bottom:48px">
          <div style={`background:${s.bg};border:2px solid ${s.bd};border-radius:var(--r-xl);width:72px;height:72px;display:flex;align-items:center;justify-content:center;font-size:2.2rem;flex-shrink:0`}>
            {s.icon}
          </div>
          <div>
            <p style={`font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:${s.couleur};margin-bottom:4px`}>
              {s.mois}
            </p>
            <h2 style={`color:${s.couleur};margin:0;font-size:2rem`}>{s.nom}</h2>
          </div>
          <div style="margin-left:auto">
            <div style={`background:${s.bg};border:1px solid ${s.bd};border-radius:var(--r-pill);padding:6px 16px`}>
              <span style={`font-size:.75rem;font-weight:700;color:${s.couleur}`}>{s.programme}</span>
            </div>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start">

          <!-- Texte -->
          <div>
            <p style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--txt-lt);margin-bottom:16px">
              {s.angle}
            </p>
            {s.corps.map(p => (
              <p style="color:var(--txt-md);line-height:1.75;margin-bottom:14px" class="fi">{p}</p>
            ))}
            {s.astuce && (
              <div style={`background:${s.bg};border-left:3px solid ${s.couleur};border-radius:0 var(--r-md) var(--r-md) 0;padding:14px 18px;margin-top:20px;font-size:.83rem;color:var(--txt-md)`} class="fi">
                <strong>Suggestion :</strong> {s.astuce}
              </div>
            )}
          </div>

          <!-- Usages & CTA -->
          <div class="fi">
            <div style={`background:${s.bg};border:1px solid ${s.bd};border-radius:var(--r-xl);padding:32px`}>
              <h4 style={`color:${s.couleur};font-size:.85rem;letter-spacing:.06em;text-transform:uppercase;margin-bottom:20px`}>
                Usages de saison
              </h4>
              <div style="display:flex;flex-direction:column;gap:10px">
                {s.usages.map(u => (
                  <div style="display:flex;align-items:center;gap:10px">
                    <span style={`width:8px;height:8px;border-radius:50%;background:${s.couleur};flex-shrink:0`}></span>
                    <span style="font-size:.88rem;color:var(--txt-md)">{u}</span>
                  </div>
                ))}
              </div>
              <div style="margin-top:28px;padding-top:24px;border-top:1px solid rgba(0,0,0,.08)">
                <a href="/recettes" style={`display:inline-flex;align-items:center;gap:6px;font-size:.82rem;font-weight:700;color:${s.couleur};text-decoration:none`}>
                  Voir les recettes de saison →
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
  ))}

  <!-- ════ LE RITUEL MATINAL (focus) ════ -->
  <section style="background:var(--green-deep);padding:80px 0;color:#fff">
    <div class="container">
      <div style="max-width:760px;margin:0 auto">
        <p class="sec-label fi text-center" style="color:var(--brown-lt)">Geste simple</p>
        <h2 class="fi text-center" style="color:#fff">Les 21 matins d'attention</h2>
        <div class="divider fi" style="background:var(--brown-lt);margin:14px auto 32px"></div>

        <p class="fi text-center" style="color:rgba(255,255,255,.8);font-size:1rem;line-height:1.8;margin-bottom:32px">
          Un programme de 21 matins, sans promesse, simplement pour renouer avec
          une habitude sobre, naturelle et attentive.
          Une cuillère de Sagar Ozpina dans un grand verre d'eau — avant de commencer la journée.
        </p>

        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:40px" class="fi">
          {[
            { num: '1', label: 'cuillère à café', note: 'ou 1 c. à soupe selon préférence' },
            { num: '200', label: 'ml d\'eau', note: 'minimum — température ambiante' },
            { num: '21', label: 'matins', note: 'pour intégrer le geste' },
          ].map(item => (
            <div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:var(--r-xl);padding:24px;text-align:center">
              <div style="font-size:2.2rem;font-weight:700;color:var(--brown-lt);font-family:var(--ff-disp);margin-bottom:4px">{item.num}</div>
              <div style="font-size:.9rem;color:#fff;font-weight:600;margin-bottom:6px">{item.label}</div>
              <div style="font-size:.72rem;color:rgba(255,255,255,.5)">{item.note}</div>
            </div>
          ))}
        </div>

        <div style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);border-radius:var(--r-xl);padding:24px 28px" class="fi">
          <p style="font-size:.83rem;color:rgba(255,255,255,.65);line-height:1.7;margin:0">
            ⚠️ <strong style="color:rgba(255,255,255,.85)">Conseil d'usage :</strong>
            Ne jamais consommer le vinaigre pur. Toujours dilué dans un grand verre d'eau.
            En cas de reflux, ulcère, gastrite, insuffisance rénale ou traitement médical spécifique,
            consultez un professionnel de santé.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════ LEXIQUE ════ -->
  <section class="section-white" style="padding:72px 0">
    <div class="container">
      <p class="sec-label fi text-center">Le vocabulaire BroKa</p>
      <h2 class="fi text-center">Rituel, pas cure.<br>Usage, pas effet.</h2>
      <div class="divider fi" style="margin:14px auto 48px"></div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;max-width:800px;margin:0 auto">
        <div class="fi" style="background:var(--cream);border-radius:var(--r-xl);padding:32px;border:1px solid var(--cream-bd)">
          <p style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#dc2626;margin-bottom:16px">Ce qu'on ne dit pas</p>
          {['Cure détox', 'Drainage', 'Purification', 'Brûle-graisses', 'Coupe-faim', 'Digestion légère', 'Ventre plat', 'Microbiote'].map(item => (
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;font-size:.88rem;color:var(--txt-lt)">
              <span style="color:#dc2626;font-weight:700;font-size:1rem">×</span>{item}
            </div>
          ))}
        </div>
        <div class="fi" style="background:var(--green-pale);border-radius:var(--r-xl);padding:32px;border:2px solid var(--green-mid)">
          <p style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--green-mid);margin-bottom:16px">Ce qu'on dit</p>
          {['Rituel de saison', '21 matins d\'attention', 'Geste du matin', 'Programme matinal', 'Habitude sobre', 'Cuisine attentive', 'Art de table', 'Héritage culinaire'].map(item => (
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;font-size:.88rem;color:var(--txt-md)">
              <span style="color:var(--green-mid);font-weight:700">✓</span>{item}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ════ CTA ════ -->
  <section style="background:var(--cream-dark);padding:64px 0;text-align:center">
    <div class="container">
      <h2 class="fi">Commencer le programme</h2>
      <p class="fi" style="max-width:460px;margin:14px auto 32px">
        Sagar Ozpina, vinaigre de cidre BIO basque, non filtré, avec sa mère.
        La bouteille du quotidien pour commencer.
      </p>
      <div class="fi" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
        <button class="btn btn-basque btn-lg" onclick="addToCart('vinaigre_500')">+ Ajouter Sagar Ozpina 500 ml — 17 €</button>
        <a href="/boutique" class="btn btn-outline-dk">Tous les formats</a>
      </div>
      <p class="fi" style="font-size:.8rem;color:var(--txt-lt);margin-top:20px">
        Livraison en France — Point Relais® dès 3,90 €, offerte dès 99 €
      </p>
    </div>
  </section>

</div>

</Layout>
