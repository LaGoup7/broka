---
import Layout from '../../layouts/Layout.astro';

const recettes = [
  {
    slug:    'vinaigrette-basque',
    titre:   'Vinaigrette basque au Sagar Ozpina',
    tag:     'Vinaigrette',
    emoji:   '🥗',
    temps:   '5 min',
    niveau:  'Très facile',
    intro:   'La vinaigrette la plus simple qui soit : huile, Sagar Ozpina, ail confit, sel. Quatre ingrédients, un résultat impeccable.',
  },
  {
    slug:    'marinade-plancha',
    titre:   'Marinade poulet à la plancha',
    tag:     'Marinade',
    emoji:   '🍗',
    temps:   '10 min',
    niveau:  'Facile',
    intro:   'Vinaigre de cidre, Xipister et herbes basques. Un accord naturel pour un poulet tendre et parfumé.',
  },
  {
    slug:    'legumes-rotis',
    titre:   'Légumes rôtis au vinaigre de cidre',
    tag:     'Légumes',
    emoji:   '🥕',
    temps:   '30 min',
    niveau:  'Facile',
    intro:   'Courgettes, tomates et poivrons rôtis. Un filet de Sagar Ozpina en fin de cuisson fait toute la différence.',
  },
  {
    slug:    'sauce-froide-xipister',
    titre:   'Sauce froide Xipister & Sagar Ozpina',
    tag:     'Sauce',
    emoji:   '🫙',
    temps:   '5 min',
    niveau:  'Très facile',
    intro:   'Une sauce froide à base de Xipister et de vinaigre de cidre. Idéale pour les grillades, les fromages et les crudités.',
  },
  {
    slug:    'haricots-blancs-piment',
    titre:   'Haricots blancs, piment doux et vinaigre',
    tag:     'Cuisine basque',
    emoji:   '🫘',
    temps:   '20 min',
    niveau:  'Facile',
    intro:   'Un plat basque simple et généreux, rehaussé d\'une touche de Sagar Ozpina et de poudre de Guindillas.',
  },
  {
    slug:    'salade-noisettes-pomme',
    titre:   'Salade de pomme, noisettes et vinaigre de cidre',
    tag:     'Salade',
    emoji:   '🥙',
    temps:   '10 min',
    niveau:  'Très facile',
    intro:   'Pommes croquantes, noisettes BIO coques, vinaigre Sagar Ozpina. Une salade du terroir, complète en un coup de fourchette.',
  },
  {
    slug:    'deglacage-poele',
    titre:   'Déglaçage simple au vinaigre de cidre',
    tag:     'Technique',
    emoji:   '🍳',
    temps:   '5 min',
    niveau:  'Facile',
    intro:   'La base de tous les jus et sauces de poêlée. Sagar Ozpina donne une acidité fine et persistante qui fixe les sucs.',
  },
];
---

<Layout
  title="Recettes au vinaigre de cidre BIO Sagar Ozpina · BroKa"
  description="7 recettes au vinaigre de cidre BIO Sagar Ozpina : vinaigrettes, marinades, légumes rôtis, cuisine basque. Des idées concrètes pour cuisiner avec un vinaigre d'auteur."
  canonicalPath="/recettes"
>

<div style="padding-top:68px">

  <!-- ════ HERO ════ -->
  <section style="background:var(--green-deep);padding:80px 0;color:#fff">
    <div class="container">
      <p class="sec-label fi" style="color:var(--brown-lt)">En cuisine</p>
      <h1 class="fi" style="color:#fff">Cuisiner avec<br><em style="color:var(--brown-lt)">Sagar Ozpina</em></h1>
      <div class="divider fi" style="background:var(--brown-lt)"></div>
      <p class="fi" style="color:rgba(255,255,255,.75);max-width:540px;font-size:1.05rem;line-height:1.8">
        Un grand vinaigre de cidre BIO, c'est avant tout un condiment de cuisine.
        Vinaigrettes, marinades, déglaçages, légumes rôtis — voici comment l'utiliser
        au quotidien, simplement et avec caractère.
      </p>
    </div>
  </section>

  <!-- ════ RECETTES GRID ════ -->
  <section class="section-white" style="padding:80px 0">
    <div class="container">
      <div class="recettes-grid">
        {recettes.map(r => (
          <a href={`/recettes/${r.slug}`} class="recette-card fi" style="text-decoration:none;color:inherit;">
            <div class="recette-img">{r.emoji}</div>
            <div class="recette-body">
              <span class="recette-tag">{r.tag}</span>
              <h3>{r.titre}</h3>
              <p>{r.intro}</p>
              <div class="recette-meta">
                <span>⏱ {r.temps}</span>
                <span>📊 {r.niveau}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ CTA BOUTIQUE ════ -->
  <section style="background:var(--cream-dark);padding:64px 0;text-align:center">
    <div class="container">
      <h2 class="fi">Commander Sagar Ozpina</h2>
      <p class="fi" style="max-width:440px;margin:14px auto 32px">
        Pour cuisiner avec un vinaigre de cidre BIO de terroir, mono-verger, non filtré.
      </p>
      <div class="fi" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
        <a href="/boutique"     class="btn btn-basque">Commander en ligne →</a>
        <a href="/sagar-ozpina" class="btn btn-outline-dk">Découvrir le vinaigre</a>
      </div>
    </div>
  </section>

</div>

</Layout>
