---
import Layout from '../layouts/Layout.astro';

const usagesCuisine = [
  {
    icon: '🥗',
    titre: 'Vinaigrettes & assaisonnements',
    desc:  'La base de toute vinaigrette digne de ce nom. Son acidité fine et ses notes de pomme remplacent avantageusement n\'importe quel vinaigre de grande surface.',
    astuce: 'Ratio : 1 volume de Sagar Ozpina pour 3 volumes d\'huile. Ajouter une pointe d\'ail confit.',
    lien:  '/recettes/vinaigrette-basque',
    tag:   'Recette →',
  },
  {
    icon: '🍗',
    titre: 'Marinades',
    desc:  'Le vinaigre attendrit les fibres et imprègne les saveurs. Avec le Xipister et les herbes basques, il crée une marinade complète pour viandes blanches, agneau et légumes.',
    astuce: 'Minimum 2h de marinade. Idéal toute une nuit pour les viandes épaisses.',
    lien:  '/recettes/marinade-plancha',
    tag:   'Recette →',
  },
  {
    icon: '🍳',
    titre: 'Déglaçages & jus',
    desc:  'Quelques cuillères dans une poêle chaude après une cuisson : Sagar Ozpina fixe les sucs, apporte de l\'acidité et allonge naturellement un jus de viande ou de légumes.',
    astuce: 'Déglacer hors du feu, puis remettre à réduire 1 minute. L\'acidité s\'assagit à la chaleur.',
    lien:  '/recettes/deglacage-poele',
    tag:   'Technique →',
  },
  {
    icon: '🫙',
    titre: 'Sauces froides',
    desc:  'Avec le Xipister, il forme la base d\'une sauce froide basque pour fromages, crudités et grillades. Quelques gouttes suffisent à équilibrer une mayonnaise ou un aïoli.',
    astuce: 'À ajouter en fin de préparation pour ne pas "cuire" l\'acidité.',
    lien:  '/recettes/sauce-froide-xipister',
    tag:   'Recette →',
  },
  {
    icon: '🥕',
    titre: 'Légumes rôtis & cuissons',
    desc:  'Un filet de Sagar Ozpina en fin de cuisson transforme des légumes rôtis ordinaires. Il relève les courgettes, les tomates confites, les carottes et les pommes de terre.',
    astuce: 'Ajouter après cuisson, pas avant — l\'acidité doit rester vive, pas cuite.',
    lien:  '/recettes/legumes-rotis',
    tag:   'Recette →',
  },
  {
    icon: '🫘',
    titre: 'Cuisine basque & plats mijotés',
    desc:  'Avec la poudre de Guindillas, Sagar Ozpina signe les plats basques : haricots blancs, piperade, poulet basquaise. Une note acide qui équilibre les préparations longues.',
    astuce: 'Dans les plats mijotés, ajouter en deux temps : en début pour attendrir, en fin pour la vivacité.',
    lien:  '/recettes/haricots-blancs-piment',
    tag:   'Recette →',
  },
];

const rituels = [
  {
    num:   '01',
    titre: 'Le rituel du matin',
    icon:  '🌅',
    corps: 'Une cuillère de Sagar Ozpina dans un grand verre d\'eau. Avant de commencer la journée — un geste sobre, naturel, inspiré des usages anciens du vinaigre.',
    note:  'Diluer 1 c. à café à 1 c. à soupe dans 200 ml d\'eau minimum. Ne jamais consommer pur.',
    cta:   'Les 21 matins d\'attention →',
    href:  '/programme-des-saisons#hiver',
  },
  {
    num:   '02',
    titre: 'Avant le repas',
    icon:  '🍽️',
    corps: 'Quelques gouttes dans un verre d\'eau ou directement dans une vinaigrette légère. Un rituel de table pour ouvrir le repas par une note vive, fruitée et basque.',
    note:  null,
    cta:   null,
    href:  null,
  },
  {
    num:   '03',
    titre: 'Le compagnon des cuisines attentives',
    icon:  '👨‍🍳',
    corps: 'Vinaigrette, marinade, déglaçage, sauce froide, légumes rôtis — Sagar Ozpina révèle toute sa place dans les gestes de cuisine. Son acidité fine travaille les contrastes : gras/vif, doux/acidulé, chaud/frais.',
    note:  null,
    cta:   'Voir les recettes →',
    href:  '/recettes',
  },
];
---

<Layout
  title="Sagar Ozpina — Vinaigre de cidre BIO mono-verger · BroKa"
  description="Sagar Ozpina : vinaigre de cidre BIO de Soule. Comment l'utiliser en cuisine, au quotidien et au fil des saisons. Fermentation lente, non filtré, avec la mère."
  canonicalPath="/sagar-ozpina"
>

<div style="padding-top:68px">

  <!-- ════ HERO PRODUIT ════ -->
  <section style="background:var(--green-deep);padding:80px 0;color:#fff">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">
        <div>
          <p class="sec-label fi" style="color:var(--brown-lt)">Notre vinaigre signature</p>
          <h1 class="fi" style="color:#fff;margin-bottom:12px">
            <em style="color:var(--brown-lt)">Sagar Ozpina</em>
          </h1>
          <p class="fi" style="color:rgba(255,255,255,.6);font-size:1rem;margin-bottom:24px;letter-spacing:.05em">
            Vinaigre de cidre BIO · Mono-verger · Soule, Pays Basque
          </p>
          <div class="divider fi" style="background:var(--brown-lt)"></div>
          <p class="fi" style="color:rgba(255,255,255,.8);font-size:1.05rem;line-height:1.8;margin-bottom:16px">
            <em>Sagar</em> — pomme. <em>Ozpina</em> — vinaigre, en basque.<br>
            Un vinaigre de cidre BIO issu d'un seul verger en Soule,
            fermenté lentement, non filtré, non pasteurisé, conservé avec sa mère vivante.
          </p>
          <!-- Navigation ancrée -->
          <div class="fi" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px">
            {['#en-cuisine', '#rituels', '#recettes', '#formats'].map((h, i) => {
              const labels = ['En cuisine', 'Rituels', 'Recettes', 'Formats'];
              return (
                <a href={h} style="background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.8);font-size:.75rem;font-weight:600;padding:5px 14px;border-radius:var(--r-pill);text-decoration:none">{labels[i]}</a>
              );
            })}
          </div>
          <div style="display:flex;gap:12px;flex-wrap:wrap">
            <button class="btn btn-basque" onclick="addToCart('vinaigre_500')">+ Panier — 500 ml (17 €)</button>
            <a href="/boutique" class="btn btn-outline">Voir tous les formats</a>
          </div>
        </div>
        <div class="fi" style="border-radius:var(--r-xl);overflow:hidden;box-shadow:var(--sh-lg);aspect-ratio:3/4;background:rgba(255,255,255,.05)">
          <img src="/images/broka_bouteille_pommes.jpg" alt="Sagar Ozpina — Vinaigre de cidre BIO BroKa"
            style="width:100%;height:100%;object-fit:cover" loading="eager">
        </div>
      </div>
    </div>
  </section>

  <!-- ════ ATTRIBUTS ════ -->
  <div class="proof-strip">
    <div class="proof-list">
      <span class="proof-item">🌿 BIO FR-BIO-10</span>
      <span class="proof-sep">·</span>
      <span class="proof-item">Non filtré</span>
      <span class="proof-sep">·</span>
      <span class="proof-item">Non pasteurisé</span>
      <span class="proof-sep">·</span>
      <span class="proof-item">Avec la mère</span>
      <span class="proof-sep">·</span>
      <span class="proof-item">Sans additif</span>
      <span class="proof-sep">·</span>
      <span class="proof-item">Sans sucre ajouté</span>
      <span class="proof-sep">·</span>
      <span class="proof-item">Mono-verger · Soule</span>
    </div>
  </div>

  <!-- ════ DÉGUSTATION ════ -->
  <section class="section-white" style="padding:72px 0">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;max-width:960px;margin:0 auto">
        <div>
          <p class="sec-label fi">Profil sensoriel</p>
          <h2 class="fi" style="margin-bottom:8px">Ce que vous allez goûter</h2>
          <div class="divider fi"></div>
          <p class="fi" style="color:var(--txt-md);line-height:1.75;margin-bottom:28px">
            Sagar Ozpina n'a pas le goût acide et plat d'un vinaigre industriel.
            C'est un vinaigre de gastronomie — complexe, vif, avec du fond.
          </p>
          <div style="display:flex;flex-direction:column;gap:16px" class="fi">
            {[
              { label: 'Acidité fine',     desc: 'Vive sans agresser — elle relève sans masquer les autres saveurs.',       pct: 80 },
              { label: 'Notes de pomme',   desc: 'Le fruit est là, reconnaissable, fruit des quatre variétés basques.',     pct: 70 },
              { label: 'Rondeur',          desc: 'La fermentation lente apporte une texture souple, sans rudesse.',         pct: 60 },
              { label: 'Vivacité finale',  desc: 'La persistance en bouche, signature d\'un vinaigre non pasteurisé.',      pct: 75 },
            ].map(n => (
              <div>
                <div style="display:flex;justify-content:space-between;margin-bottom:6px">
                  <span style="font-size:.88rem;font-weight:700;color:var(--green-deep)">{n.label}</span>
                </div>
                <div style="background:var(--cream);border-radius:var(--r-pill);height:6px;overflow:hidden;margin-bottom:6px">
                  <div style={`background:var(--green-mid);height:100%;width:${n.pct}%;border-radius:var(--r-pill);transition:width .6s`}></div>
                </div>
                <p style="font-size:.78rem;color:var(--txt-lt);line-height:1.5">{n.desc}</p>
              </div>
            ))}
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px" class="fi">
          <div style="background:var(--cream);border-radius:var(--r-xl);padding:24px;border:1px solid var(--cream-bd);grid-column:1/-1">
            <p style="font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--txt-lt);margin-bottom:10px">Couleur & aspect</p>
            <p style="font-size:.88rem;color:var(--txt-md);line-height:1.65">
              Ambre dorée, légèrement trouble — signe d'un vinaigre non filtré.
              La mère peut être visible au fond du contenant.
              C'est normal. C'est voulu.
            </p>
          </div>
          <div style="background:var(--cream);border-radius:var(--r-xl);padding:24px;border:1px solid var(--cream-bd)">
            <p style="font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--txt-lt);margin-bottom:10px">Acidité</p>
            <p style="font-size:1.8rem;font-weight:700;color:var(--green-deep);font-family:var(--ff-disp)">~5–6 %</p>
            <p style="font-size:.75rem;color:var(--txt-lt)">d'acide acétique — équilibré</p>
          </div>
          <div style="background:var(--cream);border-radius:var(--r-xl);padding:24px;border:1px solid var(--cream-bd)">
            <p style="font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--txt-lt);margin-bottom:10px">Fermentation</p>
            <p style="font-size:1.8rem;font-weight:700;color:var(--green-deep);font-family:var(--ff-disp)">Lente</p>
            <p style="font-size:.75rem;color:var(--txt-lt)">naturelle, sans accélérateur</p>
          </div>
          <div style="background:var(--green-pale);border-radius:var(--r-xl);padding:24px;border:1px solid var(--green-mid);grid-column:1/-1">
            <p style="font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--green-mid);margin-bottom:8px">Conservation</p>
            <p style="font-size:.85rem;color:var(--txt-md);line-height:1.6">
              À température ambiante, à l'abri de la lumière.
              Une fois ouvert, le vinaigre se conserve indéfiniment —
              son acidité naturelle l'auto-préserve.
              Les contenants vrac push-up refermables se conservent de la même façon.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════ LES 4 POMMES ════ -->
  <section style="background:var(--cream);padding:80px 0">
    <div class="container">
      <p class="sec-label fi text-center">Le secret du goût</p>
      <h2 class="fi text-center">Quatre pommes ancestrales basques</h2>
      <div class="divider fi" style="margin:14px auto 28px"></div>
      <p class="fi text-center" style="max-width:580px;margin:0 auto 48px">
        La complexité aromatique de Sagar Ozpina naît du mariage de quatre variétés
        anciennes, cultivées sans traitement dans le verger familial de Soule.
        Chacune apporte sa contribution au caractère final du vinaigre.
      </p>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px" class="fi">
        {[
          { nom: 'Moko',        role: 'Structure',  note: 'Amère, tannique. La colonne vertébrale du vinaigre — elle lui donne son caractère et sa persistance.' },
          { nom: 'Urtebi handi', role: 'Rondeur',   note: 'Douce et aromatique. Elle apporte la rondeur, le fruit et l\'arrondi final en bouche.' },
          { nom: 'Patzolua',    role: 'Vivacité',   note: 'Acidité vive et nette. Elle contribue à la vivacité et à la tension que l\'on ressent en fin de dégustation.' },
          { nom: 'Gezamina',    role: 'Équilibre',  note: 'Sucrée et parfumée. Elle tempère l\'ensemble et apporte les notes de pomme mûre reconnaissables.' },
        ].map(v => (
          <div style="background:#fff;border:1px solid var(--cream-bd);border-radius:var(--r-xl);padding:28px 20px;text-align:center">
            <div style="font-size:2rem;margin-bottom:8px">🍎</div>
            <p style="font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--txt-lt);margin-bottom:6px">{v.role}</p>
            <h3 style="font-size:1.05rem;color:var(--green-deep);font-style:italic;margin-bottom:10px">{v.nom}</h3>
            <p style="font-size:.82rem;color:var(--txt-lt);line-height:1.6">{v.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ EN CUISINE ════ -->
  <section id="en-cuisine" class="section-white" style="padding:80px 0">
    <div class="container">
      <p class="sec-label fi text-center">Utilisations</p>
      <h2 class="fi text-center">Sagar Ozpina en cuisine</h2>
      <div class="divider fi" style="margin:14px auto 16px"></div>
      <p class="fi text-center" style="max-width:580px;margin:0 auto 48px;color:var(--txt-lt)">
        Un vinaigre de gastronomie s'utilise partout où un bon condiment fait la différence.
        Son acidité fine travaille les contrastes — gras/vif, doux/acidulé, chaud/frais.
      </p>

      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
        {usagesCuisine.map(u => (
          <div style="background:#fff;border:1px solid var(--cream-bd);border-radius:var(--r-xl);padding:28px;display:flex;flex-direction:column" class="fi">
            <div style="font-size:2rem;margin-bottom:12px">{u.icon}</div>
            <h3 style="font-size:.95rem;color:var(--green-deep);margin-bottom:10px">{u.titre}</h3>
            <p style="font-size:.83rem;color:var(--txt-md);line-height:1.65;flex:1;margin-bottom:16px">{u.desc}</p>
            <div style="background:var(--cream);border-radius:var(--r-md);padding:10px 14px;font-size:.78rem;color:var(--txt-lt);border-left:3px solid var(--brown);margin-bottom:16px">
              <strong>Astuce :</strong> {u.astuce}
            </div>
            <a href={u.lien} style="font-size:.8rem;font-weight:700;color:var(--green-mid);text-decoration:none">
              {u.tag}
            </a>
          </div>
        ))}
      </div>

      <!-- Contraste usage -->
      <div style="margin-top:48px;background:var(--green-deep);border-radius:var(--r-xl);padding:40px;display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:24px;text-align:center" class="fi">
        {[
          { v1: 'Gras', op: '/', v2: 'Vif' },
          { v1: 'Doux', op: '/', v2: 'Acidulé' },
          { v1: 'Chaud', op: '/', v2: 'Frais' },
          { v1: 'Riche', op: '/', v2: 'Tendu' },
        ].map(c => (
          <div>
            <p style="font-size:1.1rem;font-weight:700;color:#fff;font-family:var(--ff-disp)">{c.v1} <span style="color:var(--brown-lt)">{c.op}</span> {c.v2}</p>
            <p style="font-size:.72rem;color:rgba(255,255,255,.4);margin-top:4px">contraste de saveur</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ RITUELS D'USAGE ════ -->
  <section id="rituels" style="background:var(--cream);padding:80px 0">
    <div class="container">
      <p class="sec-label fi text-center">Gestes simples</p>
      <h2 class="fi text-center">Rituels d'usage</h2>
      <div class="divider fi" style="margin:14px auto 48px"></div>

      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:960px;margin:0 auto">
        {rituels.map(r => (
          <div style="background:#fff;border-radius:var(--r-xl);padding:36px 28px;border:1px solid var(--cream-bd);display:flex;flex-direction:column" class="fi">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
              <span style="font-size:1.8rem">{r.icon}</span>
              <span style="font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--txt-lt)">{r.num}</span>
            </div>
            <h3 style="font-size:1rem;color:var(--green-deep);margin-bottom:12px">{r.titre}</h3>
            <p style="font-size:.85rem;color:var(--txt-md);line-height:1.7;flex:1;margin-bottom:16px">{r.corps}</p>
            {r.note && (
              <div style="background:var(--cream);border-radius:var(--r-md);padding:10px 14px;font-size:.77rem;color:var(--txt-lt);border-left:3px solid var(--green-mid);margin-bottom:16px">
                ⚠️ {r.note}
              </div>
            )}
            {r.cta && (
              <a href={r.href} style="font-size:.8rem;font-weight:700;color:var(--green-mid);text-decoration:none;margin-top:auto">
                {r.cta}
              </a>
            )}
          </div>
        ))}
      </div>

      <div class="fi" style="text-align:center;margin-top:40px">
        <a href="/programme-des-saisons" class="btn btn-primary">Le programme des saisons complet →</a>
      </div>
    </div>
  </section>

  <!-- ════ RECETTES ASSOCIÉES ════ -->
  <section id="recettes" class="section-white" style="padding:80px 0">
    <div class="container">
      <p class="sec-label fi text-center">Idées de recettes</p>
      <h2 class="fi text-center">Ce que vous pouvez faire<br>dès ce soir</h2>
      <div class="divider fi" style="margin:14px auto 48px"></div>

      <div class="recettes-grid">
        {[
          { href: '/recettes/vinaigrette-basque',   emoji: '🥗', tag: 'Très facile', titre: 'Vinaigrette basque',          temps: '5 min',  intro: 'Huile, Sagar Ozpina, ail confit, sel de Guérande. Quatre ingrédients, un résultat impeccable.' },
          { href: '/recettes/marinade-plancha',     emoji: '🍗', tag: 'Facile',      titre: 'Marinade poulet plancha',     temps: '10 min', intro: 'Vinaigre de cidre, Xipister, herbes basques. Un accord naturel pour un poulet tendre et parfumé.' },
          { href: '/recettes/deglacage-poele',      emoji: '🍳', tag: 'Technique',   titre: 'Déglaçage au vinaigre',      temps: '5 min',  intro: 'La base de tous les jus. Une acidité fine et persistante qui fixe les sucs de cuisson.' },
          { href: '/recettes/legumes-rotis',        emoji: '🥕', tag: 'Facile',      titre: 'Légumes rôtis',               temps: '30 min', intro: 'Un filet de Sagar Ozpina en fin de cuisson fait toute la différence sur des légumes rôtis.' },
          { href: '/recettes/sauce-froide-xipister', emoji: '🫙', tag: 'Très facile', titre: 'Sauce froide Xipister',     temps: '5 min',  intro: 'Xipister + Sagar Ozpina — la sauce froide basque pour grillades, fromages et crudités.' },
          { href: '/recettes/haricots-blancs-piment', emoji: '🫘', tag: 'Cuisine basque', titre: 'Haricots & Guindillas', temps: '20 min', intro: 'Un plat basque simple et généreux, rehaussé d\'une touche de Sagar Ozpina et de Guindillas.' },
        ].map(r => (
          <a href={r.href} class="recette-card fi" style="text-decoration:none;color:inherit">
            <div class="recette-img">{r.emoji}</div>
            <div class="recette-body">
              <span class="recette-tag">{r.tag}</span>
              <h3>{r.titre}</h3>
              <p>{r.intro}</p>
              <div class="recette-meta">
                <span>⏱ {r.temps}</span>
                <span>Sagar Ozpina</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div style="text-align:center;margin-top:40px" class="fi">
        <a href="/recettes" class="btn btn-outline-dk">Voir toutes les recettes →</a>
      </div>
    </div>
  </section>

  <!-- ════ ARTISANAL VS INDUSTRIEL ════ -->
  <section style="background:var(--cream);padding:80px 0">
    <div class="container">
      <p class="sec-label fi text-center">Pourquoi Sagar Ozpina</p>
      <h2 class="fi text-center">Artisanal vs industriel</h2>
      <div class="divider fi" style="margin:14px auto 48px"></div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:40px;max-width:800px;margin:0 auto">
        <div class="fi" style="background:#fff;border-radius:var(--r-lg);padding:32px;border:2px solid var(--green-pale)">
          <p style="font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--green-mid);margin-bottom:16px">Sagar Ozpina</p>
          {['Un seul verger, en Soule', 'Fermentation naturelle lente', 'Non filtré — la mère est présente', 'Non pasteurisé — vivant', '100 % pommes basques ancestrales', 'Sans additif, sans correcteur d\'acidité'].map(item => (
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;font-size:.88rem;color:var(--txt-md)">
              <span style="color:#16a34a;font-weight:700">✓</span>{item}
            </div>
          ))}
        </div>
        <div class="fi" style="background:#fff;border-radius:var(--r-lg);padding:32px;border:1px solid var(--cream-bd)">
