---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="BroKa — Sagar Ozpina, vinaigre de cidre BIO du Pays Basque"
  description="Sagar Ozpina — Vinaigre de cidre BIO mono-verger de Soule. Non filtré, non pasteurisé, avec la mère. Ferme Goyhenetxea, Pays Basque. Commande en ligne."
  canonicalPath="/"
>

<!-- ════ HERO ════ -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-content">
    <div class="hero-badge fi">
      <span class="pulse"></span>
      GAEC Goyhenetxea · Soule, Xiberoa · Pays Basque français
    </div>
    <h1 class="fi">
      <em>Sagar Ozpina,</em><br>
      le vinaigre de cidre BIO<br>
      du Pays Basque
    </h1>
    <p class="hero-sub fi">
      Un vinaigre vivant, issu d'un seul verger en Soule, fermenté lentement
      et conservé avec sa mère.
    </p>
    <div class="hero-ctas fi">
      <a href="/sagar-ozpina" class="btn btn-basque btn-lg">Découvrir le vinaigre →</a>
      <a href="/boutique"     class="btn btn-outline btn-lg">Commander en ligne</a>
    </div>
    <div class="hero-market fi">
      <span class="pulse"></span>
      Prochain marché : <strong id="market-text">Chargement…</strong>
    </div>
  </div>
</section>

<!-- ════ PROOF STRIP ════ -->
<div class="proof-strip">
  <div class="proof-list">
    <span class="proof-item">🌿 Agriculture Biologique FR-BIO-10</span>
    <span class="proof-sep">·</span>
    <span class="proof-item">🍎 Mono-verger en Soule</span>
    <span class="proof-sep">·</span>
    <span class="proof-item">⏳ Fermentation lente</span>
    <span class="proof-sep">·</span>
    <span class="proof-item">💧 Non filtré</span>
    <span class="proof-sep">·</span>
    <span class="proof-item">🔥 Non pasteurisé</span>
    <span class="proof-sep">·</span>
    <span class="proof-item">✨ Avec la mère</span>
    <span class="proof-sep">·</span>
    <span class="proof-item">🏔️ Pays Basque, France</span>
  </div>
</div>

<!-- ════ PRODUIT PHARE ════ -->
<section class="section-white" style="padding:80px 0">
  <div class="container">
    <div class="phare-grid">

      <div class="phare-img-wrap fi">
        <img src="/images/broka_bouteille_pommes.jpg" alt="Sagar Ozpina — Vinaigre de cidre BIO BroKa 500ml" loading="lazy">
      </div>

      <div>
        <p class="sec-label fi">Notre produit signature</p>
        <h2 class="fi">Sagar Ozpina</h2>
        <div class="divider fi"></div>
        <p class="fi" style="font-size:1.05rem;margin-bottom:20px;">
          Un vinaigre de cidre BIO élaboré sur un seul verger en Soule, avec quatre variétés de
          pommes ancestrales basques — récoltées à la main, pressées, fermentées lentement
          et élevées sans pasteurisation.
        </p>

        <div class="phare-badges fi">
          <span class="phare-badge green">✓ BIO FR-BIO-10</span>
          <span class="phare-badge">Non filtré</span>
          <span class="phare-badge">Non pasteurisé</span>
          <span class="phare-badge">Avec la mère</span>
          <span class="phare-badge">Mono-verger</span>
          <span class="phare-badge">Sans additif</span>
        </div>

        <p class="fi" style="font-size:.82rem;color:var(--txt-lt);font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-bottom:10px;">
          Notes de dégustation
        </p>
        <div class="degustation fi">
          <span class="deg-item">Acidité fine</span>
          <span class="deg-item">Notes de pomme</span>
          <span class="deg-item">Rondeur</span>
          <span class="deg-item">Vivacité</span>
        </div>

        <div class="phare-price fi">
          17 € <small>/ 500 ml</small>
        </div>

        <div class="phare-actions fi">
          <button class="btn btn-basque" onclick="addToCart('vinaigre_500')">+ Ajouter au panier</button>
          <a href="/boutique" class="btn btn-outline-dk">Voir tous les formats</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ TERROIR ════ -->
<section class="terroir-section">
  <div class="terroir-grid">
    <div class="terroir-img">
      <img src="/images/broka_couples_berger_verger.jpg" alt="Maïté et Olivier Latchere dans leur verger en Soule" loading="lazy">
    </div>
    <div class="terroir-content">
      <p class="sec-label fi">Origine</p>
      <h2 class="fi">Un seul verger,<br>en Soule — Xiberoa</h2>
      <div class="divider fi"></div>
      <p class="fi">
        Maïté et Olivier Latchere sont paysans bio au cœur des montagnes basques,
        en Soule — la plus petite et l'une des plus authentiques provinces du Pays Basque.
        Troisième génération à faire vivre la ferme Goyhenetxea.
      </p>
      <p class="fi" style="margin-top:14px;">
        1 500 pommiers de variétés anciennes, cultivés sans traitement, dans le respect
        du vivant, des sols et des saisons. Quatre pommes font Sagar Ozpina :
      </p>
      <div class="varietes fi">
        <div class="variete-item">Moko</div>
        <div class="variete-item">Urtebi handi</div>
        <div class="variete-item">Patzolua</div>
        <div class="variete-item">Gezamina</div>
      </div>
      <a href="/histoire" class="btn btn-outline fi">Notre histoire →</a>
    </div>
  </div>
</section>

<!-- ════ FERMENTATION ════ -->
<section class="ferm-section">
  <div class="container">
    <p class="sec-label fi text-center">La méthode</p>
    <h2 class="fi text-center">Fermenté lentement,<br>élevé à l'air libre</h2>
    <div class="divider fi" style="margin-left:auto;margin-right:auto;"></div>
    <p class="fi text-center" style="max-width:560px;margin:0 auto 48px;">
      Contrairement au vinaigre industriel produit en quelques heures,
      Sagar Ozpina naît d'une double fermentation naturelle, au rythme des saisons.
    </p>

    <div class="ferm-steps">
      <div class="ferm-step fi">
        <div class="ferm-step-num">1</div>
        <h4>La récolte</h4>
        <p>Pommes basques récoltées à la main en automne, au pic de maturité.</p>
      </div>
      <div class="ferm-step fi">
        <div class="ferm-step-num">2</div>
        <h4>Le pressage</h4>
        <p>Jus pressé dans les 24h, sans additif, sans sucre ajouté, sans correcteur d'acidité.</p>
      </div>
      <div class="ferm-step fi">
        <div class="ferm-step-num">3</div>
        <h4>La fermentation</h4>
        <p>Double fermentation naturelle et lente : alcoolique puis acétique, sans accélérateur.</p>
      </div>
      <div class="ferm-step fi">
        <div class="ferm-step-num">4</div>
        <h4>L'élevage</h4>
        <p>Élevé à l'air libre, au rythme du vent, du froid et du soleil basques.</p>
      </div>
      <div class="ferm-step fi">
        <div class="ferm-step-num">5</div>
        <h4>La mère</h4>
        <p>Non filtré, non pasteurisé. La mère de vinaigre est préservée. Le vinaigre reste vivant.</p>
      </div>
    </div>

    <div class="ferm-connector fi">
      <a href="/sagar-ozpina" style="color:var(--brown);font-weight:700;font-size:.85rem;">
        En savoir plus sur Sagar Ozpina →
      </a>
    </div>
  </div>
</section>

<!-- ════ RITUEL ════ -->
<section style="background:var(--cream-dark);padding:80px 0">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center">

      <div>
        <p class="sec-label fi">Rituels & usages</p>
        <h2 class="fi">Un rituel simple,<br>toute l'année</h2>
        <div class="divider fi"></div>
        <p class="fi" style="font-size:1.05rem;line-height:1.8;margin-bottom:20px">
          Sagar Ozpina accompagne les gestes simples du quotidien :
          une vinaigrette, une marinade, un déglaçage,
          ou une cuillère diluée dans un grand verre d'eau.
        </p>
        <p class="fi" style="color:var(--txt-lt);line-height:1.75;margin-bottom:32px">
          Au fil des saisons, il trouve sa place dans les cuisines attentives,
          les tables familiales et les habitudes sobres.
          Hiver, printemps, été, automne — quatre saisons, quatre façons de l'intégrer.
        </p>
        <div class="fi" style="display:flex;gap:12px;flex-wrap:wrap">
          <a href="/programme-des-saisons" class="btn btn-primary">Le programme des saisons →</a>
          <a href="/rituels"               class="btn btn-outline-dk">Rituels & usages</a>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px" class="fi">
        {[
          { icon: '❄️', saison: 'Hiver',     titre: 'Les 21 matins d\'attention',    txt: 'Un geste sobre, une cuillère dans un verre d\'eau, quelques minutes pour soi.' },
          { icon: '🌿', saison: 'Printemps', titre: 'Le rituel de printemps',        txt: 'Salades vives, herbes fraîches, légumes nouveaux et vinaigrettes légères.' },
          { icon: '☀️', saison: 'Été',       titre: 'L\'été vif & basque',           txt: 'Grillades, marinades, plancha, Xipister et Guindillas.' },
          { icon: '🍎', saison: 'Automne',   titre: 'Le temps des pommes',           txt: 'Récolte, terroir, déglaçages et plats généreux d\'automne.' },
        ].map(s => (
          <a href="/programme-des-saisons" style="background:#fff;border:1px solid var(--cream-bd);border-radius:var(--r-xl);padding:20px;text-decoration:none;color:inherit;display:block">
            <div style="font-size:1.8rem;margin-bottom:10px">{s.icon}</div>
            <p style="font-size:.65rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--txt-lt);margin-bottom:4px">{s.saison}</p>
            <h4 style="color:var(--green-deep);font-size:.88rem;margin-bottom:8px">{s.titre}</h4>
            <p style="font-size:.78rem;color:var(--txt-lt);line-height:1.55">{s.txt}</p>
          </a>
        ))}
      </div>

    </div>
  </div>
</section>

<!-- ════ RECETTES TEASER ════ -->
<section class="recettes-section">
  <div class="container">
    <p class="sec-label fi">En cuisine</p>
    <h2 class="fi">Ce que vous pouvez faire<br>avec Sagar Ozpina</h2>
    <div class="divider fi"></div>
    <p class="fi" style="max-width:520px;">
      Un vinaigre gastronomique s'utilise partout où un bon condiment fait la différence :
      vinaigrettes, marinades, déglaçages, légumes rôtis, sauces.
    </p>

    <div class="recettes-grid">
      <a href="/recettes/vinaigrette-basque" class="recette-card fi" style="text-decoration:none;color:inherit;">
        <div class="recette-img">🥗</div>
        <div class="recette-body">
          <span class="recette-tag">Vinaigrette</span>
          <h3>Vinaigrette basque au Sagar Ozpina</h3>
          <p>Huile, vinaigre de cidre BIO, ail confit, sel de Guérande. La plus simple et la meilleure.</p>
          <div class="recette-meta">
            <span>⏱ 5 min</span>
            <span>👶 Très facile</span>
          </div>
        </div>
      </a>

      <a href="/recettes/marinade-plancha" class="recette-card fi" style="text-decoration:none;color:inherit;">
        <div class="recette-img">🍗</div>
        <div class="recette-body">
          <span class="recette-tag">Marinade</span>
          <h3>Marinade pour poulet à la plancha</h3>
          <p>Vinaigre de cidre, Xipister, herbes du Pays Basque. Un accord naturel.</p>
          <div class="recette-meta">
            <span>⏱ 10 min</span>
            <span>🌶️ Avec Xipister</span>
          </div>
        </div>
      </a>

      <a href="/recettes/legumes-rotis" class="recette-card fi" style="text-decoration:none;color:inherit;">
        <div class="recette-img">🥕</div>
        <div class="recette-body">
          <span class="recette-tag">Légumes</span>
          <h3>Légumes rôtis au vinaigre de cidre</h3>
          <p>Courgettes, tomates et poivrons rôtis avec un filet de Sagar Ozpina en fin de cuisson.</p>
          <div class="recette-meta">
            <span>⏱ 30 min</span>
            <span>🔥 Four 200°C</span>
          </div>
        </div>
      </a>
    </div>

    <div class="recettes-cta fi">
      <a href="/recettes" class="btn btn-primary">Voir toutes les recettes →</a>
    </div>
  </div>
</section>

<!-- ════ MARCHÉS ════ -->
<section id="marches" class="section-white" style="padding:80px 0">
  <div class="container">
    <p class="sec-label fi">Nous retrouver</p>
    <h2 class="fi">Sur les marchés</h2>
    <div class="divider fi"></div>
    <p class="fi">Chaque samedi sur l'un de nos deux marchés — venez goûter et acheter directement.</p>
    <div class="marches-grid">
      <div class="marche-card active fi">
        <div class="marche-week">Ce samedi</div>
        <h3 id="marche-now-nom">—</h3>
        <div class="marche-city"  id="marche-now-city">—</div>
        <div class="marche-addr"  id="marche-now-addr">—</div>
        <div class="marche-hours" id="marche-now-hours">—</div>
        <div class="marche-live"><span class="pulse"></span> Présents ce week-end</div>
      </div>
      <div class="marche-card fi">
        <div class="marche-week">Samedi prochain</div>
        <h3 id="marche-next-nom">—</h3>
        <div class="marche-city"  id="marche-next-city">—</div>
        <div class="marche-addr"  id="marche-next-addr">—</div>
        <div class="marche-hours" id="marche-next-hours">—</div>
      </div>
    </div>
  </div>
</section>

<!-- ════ AVIS ════ -->
<section id="avis" class="avis-section">
  <div class="container">
    <p class="sec-label fi">Ils nous font confiance</p>
    <h2 class="fi">Ce qu'ils disent</h2>
    <div class="divider fi"></div>
    <div class="avis-grid">
      <div class="avis-card fi">
        <div class="avis-quote">&ldquo;</div>
        <div class="stars">★★★★★</div>
        <p class="avis-txt">Un vinaigre d'une qualité exceptionnelle. J'utilise le vrac 3L depuis six mois — je ne peux plus m'en passer pour mes salades et mes marinades.</p>
        <div class="avis-footer">
          <div class="avis-avatar">ML</div>
          <div>
            <div class="avis-author">Marie L.</div>
            <div class="avis-source">Pau · Cliente fidèle</div>
          </div>
        </div>
      </div>
      <div class="avis-card fi">
        <div class="avis-quote">&ldquo;</div>
        <div class="stars">★★★★★</div>
        <p class="avis-txt">Le Xipister est un régal sur la plancha. J'en offre à chaque apéro — mes amis me réclament l'adresse depuis !</p>
        <div class="avis-footer">
          <div class="avis-avatar">JB</div>
          <div>
            <div class="avis-author">Jean-Pierre B.</div>
            <div class="avis-source">Biarritz · Acheté au marché</div>
          </div>
        </div>
      </div>
      <div class="avis-card fi">
        <div class="avis-quote">&ldquo;</div>
        <div class="stars">★★★★★</div>
        <p class="avis-txt">Produit artisanal et authentique, livraison soignée. On sent vraiment le travail fait à la ferme — je recommande sans hésiter.</p>
        <div class="avis-footer">
          <div class="avis-avatar">SM</div>
          <div>
            <div class="avis-author">Sophie M.</div>
            <div class="avis-source">Bayonne · Commande en ligne</div>
          </div>
        </div>
      </div>
      <div id="avis-dynamic"></div>
    </div>
    <div class="avis-cta fi">
      <button class="btn-avis" onclick="openAvisModal()">✍️ Laisser un avis</button>
    </div>
  </div>
</section>

<!-- ════ GUIDE ════ -->
<section id="guide" class="guide-section">
  <div class="container">
    <div class="guide-grid">
      <div>
        <p class="sec-label fi">Cadeau offert</p>
        <h2 class="fi">7 gestes de cuisine<br>avec Sagar Ozpina</h2>
        <div class="divider fi"></div>
        <p class="fi">
          Recevez notre guide PDF gratuitement — et soyez informé(e) en avant-première
          de nos présences aux marchés et de nos nouveautés.
        </p>
        <div class="guide-features fi">
          <div class="guide-feature"><div class="guide-feature-dot"></div><span>Vinaigrettes et sauces froides</span></div>
          <div class="guide-feature"><div class="guide-feature-dot"></div><span>Marinades viande, poisson, légumes</span></div>
          <div class="guide-feature"><div class="guide-feature-dot"></div><span>Déglaçages et cuissons</span></div>
          <div class="guide-feature"><div class="guide-feature-dot"></div><span>Accords avec Xipister et Guindillas</span></div>
          <div class="guide-feature"><div class="guide-feature-dot"></div><span>Recettes de cuisine basque</span></div>
        </div>
      </div>

      <div class="guide-form-wrap fi">
        <h3>Recevoir le guide gratuitement</h3>
        <form id="lead-form" novalidate>
          <!-- Honeypot -->
          <input type="text" name="website" id="hp-website" style="display:none" tabindex="-1" autocomplete="off">
          <div class="form-row">
            <div class="form-group">
              <label for="lead-prenom">Prénom *</label>
              <input type="text" id="lead-prenom" name="prenom" placeholder="Marie" autocomplete="given-name">
              <span class="form-error" id="err-prenom">Requis</span>
            </div>
            <div class="form-group">
              <label for="lead-nom">Nom</label>
              <input type="text" id="lead-nom" name="nom" placeholder="Dupont" autocomplete="family-name">
            </div>
          </div>
          <div class="form-group" style="margin-top:14px">
            <label for="lead-email">Email *</label>
            <input type="email" id="lead-email" name="email" placeholder="vous@email.fr" autocomplete="email">
            <span class="form-error" id="err-email">Email invalide</span>
          </div>
          <div class="form-group" style="margin-top:14px">
            <label for="lead-tel">Téléphone <span style="font-weight:400;opacity:.6">(facultatif)</span></label>
            <input type="tel" id="lead-tel" name="tel" placeholder="06 12 34 56 78" autocomplete="tel" oninput="formatTel(this)">
          </div>
          <div class="form-submit">
            <button type="submit" class="btn btn-basque btn-full btn-lg">
              Recevoir le guide gratuit →
            </button>
          </div>
          <p class="form-legal">
            Vos données sont utilisées uniquement pour vous envoyer le guide et, si vous y consentez,
            des nouvelles de BroKa. Aucune cession à des tiers.
            <a href="/mentions-legales" style="color:rgba(255,255,255,.5);text-decoration:underline">Politique de confidentialité</a>.
          </p>
        </form>
        <div id="lead-success" style="display:none;text-align:center;padding:20px 0">
          <div style="font-size:3rem;margin-bottom:12px">🎉</div>
          <h3 style="color:#fff;margin-bottom:8px">Votre guide arrive !</h3>
          <p style="color:rgba(255,255,255,.75);font-size:.9rem;">Vérifiez votre boîte mail (et les spams si besoin).</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════ SCRIPTS PAGE ════ -->
<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  // Chargement avis dynamiques Redis
  fetch('/api/reviews')
    .then(r => r.json())
    .then(data => {
      const container = document.getElementById('avis-dynamic');
      if (!container || !data.reviews?.length) return;
      container.innerHTML = data.reviews.map(r => `
        <div class="avis-card">
          <div class="avis-quote">&ldquo;</div>
          <div class="stars">${'★'.repeat(r.rating)}${'☆'.repeat(5-r.rating)}</div>
          <p class="avis-txt">${r.texte}</p>
          <div class="avis-footer">
            <div class="avis-avatar">${r.prenom.charAt(0).toUpperCase()}</div>
            <div>
              <div class="avis-author">${r.prenom}</div>
              <div class="avis-source">Avis vérifié</div>
            </div>
          </div>
        </div>`).join('');
    }).catch(() => {});

  // Formulaire guide
  const form = document.getElementById('lead-form');
  if (!form) return;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const honey  = document.getElementById('hp-website').value;
    if (honey) return;
    const prenom = document.getElementById('lead-prenom').value.trim();
    const nom    = document.getElementById('lead-nom').value.trim();
    const email  = document.getElementById('lead-email').value.trim();
    const tel    = document.getElementById('lead-tel').value.trim();
    let ok = true;
    const errPrenom = document.getElementById('err-prenom');
    const errEmail  = document.getElementById('err-email');
    if (!prenom) { errPrenom.classList.add('visible'); ok = false; } else errPrenom.classList.remove('visible');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { errEmail.classList.add('visible'); ok = false; } else errEmail.classList.remove('visible');
    if (!ok) return;
    const btn = form.querySelector('button[type=submit]');
    btn.disabled = true; btn.textContent = 'Envoi…';
    try {
      const res = await fetch('/api/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prenom, nom, email, tel, source: 'guide-home-v2' }),
      });
      if (res.ok) {
        form.style.display = 'none';
        document.getElementById('lead-success').style.display = 'block';
      } else {
        throw new Error('Erreur serveur');
      }
    } catch {
      btn.disabled = false;
      btn.textContent = 'Recevoir le guide gratuit →';
      showToast('❌ Erreur, réessayez.');
    }
  });
});
</script>

</Layout>
